{
  "manifest_version": 3,
  "name": "Созвон — Teams и Zoom",
  "version": "0.4.0",
  "description": "Вход и выход по расписанию в Teams и Zoom, по времени или при оттоке участников.",
  "minimum_chrome_version": "120",
  "permissions": ["storage", "alarms", "scripting", "debugger", "nativeMessaging"],
  "host_permissions": ["https://teams.microsoft.com/*", "https://teams.live.com/*", "https://teams.cloud.microsoft/*"],
  "background": { "service_worker": "background.js", "type": "module" },
  "icons": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png" },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Созвон",
    "default_icon": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png" }
  },
  "content_scripts": [{
    "matches": ["https://teams.microsoft.com/*", "https://teams.live.com/*", "https://teams.cloud.microsoft/*"],
    "js": ["reader.js", "joiner.js", "content.js"],
    "run_at": "document_idle"
  }]
}
